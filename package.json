{
  "name": "latex-editing-toolkit",
  "displayName": "LaTeX Editing Toolkit",
  "description": "A local-first LaTeX workspace toolkit with themes, project workflows, programmable hsnips, profiles, and mathematical editing helpers.",
  "version": "1.0.0",
  "publisher": "yiqiyang33",
  "icon": "assets/latex-toolkit.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yiqiyang33/Latex-Theme-Designer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "latex",
    "tex",
    "cursor",
    "notes",
    "template",
    "hsnips",
    "programmable snippets",
    "dynamic snippets"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:hsnips",
    "onLanguage:markdown",
    "onLanguage:latex",
    "onLanguage:tex",
    "onView:latexEditingToolkit.actions",
    "onCommand:hsnips.openSnippetsDir",
    "onCommand:hsnips.openWorkspaceSnippetsDir",
    "onCommand:hsnips.openWorkspaceSnippetFile",
    "onCommand:hsnips.openSnippetFile",
    "onCommand:hsnips.openSnippetManager",
    "onCommand:hsnips.selectProfile",
    "onCommand:hsnips.openActiveProfile",
    "onCommand:hsnips.reloadSnippets",
    "onCommand:hsnips.convertEnvironment",
    "onCommand:hsnips.renameMatchingEnvironment",
    "onCommand:hsnips.wrapMathStructure",
    "onCommand:hsnips.unwrapMathStructure",
    "onCommand:hsnips.smartEnter",
    "onCommand:hsnips.smartTab",
    "onCommand:hsnips.matrixTab",
    "onCommand:hsnips.leaveSnippet",
    "onCommand:hsnips.nextPlaceholder",
    "onCommand:hsnips.prevPlaceholder",
    "onCommand:hsnips.expand",
    "onCommand:latexEditingToolkit.openToolkit",
    "onCommand:latexEditingToolkit.createProject",
    "onCommand:latexEditingToolkit.openLocalProject",
    "onCommand:latexEditingToolkit.relocateLocalProject",
    "onCommand:latexEditingToolkit.removeLocalProject",
    "onCommand:latexEditingToolkit.refreshTree",
    "onCommand:latexEditingToolkit.undoLastChange",
    "onCommand:latexEditingToolkit.redoLastChange",
    "onCommand:latexEditingToolkit.createStarterInWorkspace",
    "onCommand:latexEditingToolkit.pickCompileTarget",
    "onCommand:latexEditingToolkit.pickCompileRecipe",
    "onCommand:latexEditingToolkit.toggleInternalFallback",
    "onCommand:latexEditingToolkit.openCurrentPdf",
    "onCommand:latexEditingToolkit.toggleThemeOption",
    "onCommand:latexEditingToolkit.pickClassConfig",
    "onCommand:latexEditingToolkit.pickStylePreset",
    "onCommand:latexEditingToolkit.pickBlockPreset",
    "onCommand:latexEditingToolkit.pickHeadingTocPreset",
    "onCommand:latexEditingToolkit.pickBodyFontSize",
    "onCommand:latexEditingToolkit.initializeWorkspace",
    "onCommand:latexEditingToolkit.upgradeWorkspaceThemeAssets",
    "onCommand:latexEditingToolkit.generateVscodeSettings",
    "onCommand:latexEditingToolkit.saveOverrides",
    "onCommand:latexEditingToolkit.resetOverrides",
    "onCommand:latexEditingToolkit.compilePdf",
    "onCommand:latexEditingToolkit.cleanArtifacts",
    "onCommand:latexEditingToolkit.splitCurrentTarget",
    "onCommand:latexEditingToolkit.renumberUnits",
    "onCommand:latexEditingToolkit.unsplitUnit",
    "onWebviewPanel:latexEditingToolkit.toolkit"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "latexEditingToolkit.openToolkit",
        "title": "LaTeX Editing Toolkit: Open Toolkit"
      },
      {
        "command": "latexEditingToolkit.createProject",
        "title": "LaTeX Editing Toolkit: Create Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "latexEditingToolkit.openLocalProject",
        "title": "LaTeX Editing Toolkit: Open Local Project"
      },
      {
        "command": "latexEditingToolkit.relocateLocalProject",
        "title": "LaTeX Editing Toolkit: Relocate Local Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "latexEditingToolkit.removeLocalProject",
        "title": "LaTeX Editing Toolkit: Remove Local Project",
        "icon": "$(close)"
      },
      {
        "command": "latexEditingToolkit.refreshTree",
        "title": "LaTeX Editing Toolkit: Refresh Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "latexEditingToolkit.undoLastChange",
        "title": "LaTeX Editing Toolkit: Undo Last Change",
        "icon": "$(discard)"
      },
      {
        "command": "latexEditingToolkit.redoLastChange",
        "title": "LaTeX Editing Toolkit: Redo Last Change",
        "icon": "$(redo)"
      },
      {
        "command": "latexEditingToolkit.createStarterInWorkspace",
        "title": "LaTeX Editing Toolkit: Generate Starter In Workspace",
        "icon": "$(new-file)"
      },
      {
        "command": "latexEditingToolkit.pickCompileTarget",
        "title": "LaTeX Editing Toolkit: Pick Compile Target",
        "icon": "$(symbol-file)"
      },
      {
        "command": "latexEditingToolkit.pickCompileRecipe",
        "title": "LaTeX Editing Toolkit: Pick Compile Recipe",
        "icon": "$(settings-gear)"
      },
      {
        "command": "latexEditingToolkit.toggleInternalFallback",
        "title": "LaTeX Editing Toolkit: Toggle Internal Fallback",
        "icon": "$(debug-restart)"
      },
      {
        "command": "latexEditingToolkit.openCurrentPdf",
        "title": "LaTeX Editing Toolkit: Open Current PDF",
        "icon": "$(open-preview)"
      },
      {
        "command": "latexEditingToolkit.toggleThemeOption",
        "title": "LaTeX Editing Toolkit: Toggle Theme Option"
      },
      {
        "command": "latexEditingToolkit.pickClassConfig",
        "title": "LaTeX Editing Toolkit: Pick Class Config"
      },
      {
        "command": "latexEditingToolkit.pickStylePreset",
        "title": "LaTeX Editing Toolkit: Pick Style Preset",
        "icon": "$(symbol-color)"
      },
      {
        "command": "latexEditingToolkit.pickBlockPreset",
        "title": "LaTeX Editing Toolkit: Pick Block Preset (Legacy)",
        "icon": "$(symbol-color)"
      },
      {
        "command": "latexEditingToolkit.pickHeadingTocPreset",
        "title": "LaTeX Editing Toolkit: Pick Heading/TOC Preset (Legacy)",
        "icon": "$(list-flat)"
      },
      {
        "command": "latexEditingToolkit.pickBodyFontSize",
        "title": "LaTeX Editing Toolkit: Pick Body Font Size",
        "icon": "$(text-size)"
      },
      {
        "command": "latexEditingToolkit.initializeWorkspace",
        "title": "LaTeX Editing Toolkit: Initialize Workspace"
      },
      {
        "command": "latexEditingToolkit.upgradeWorkspaceThemeAssets",
        "title": "LaTeX Editing Toolkit: Upgrade Workspace Theme Assets"
      },
      {
        "command": "latexEditingToolkit.generateVscodeSettings",
        "title": "LaTeX Editing Toolkit: Generate VS Code Settings"
      },
      {
        "command": "latexEditingToolkit.saveOverrides",
        "title": "LaTeX Editing Toolkit: Save Overrides (Legacy)"
      },
      {
        "command": "latexEditingToolkit.resetOverrides",
        "title": "LaTeX Editing Toolkit: Reset All Toolkit Overrides"
      },
      {
        "command": "latexEditingToolkit.compilePdf",
        "title": "LaTeX Editing Toolkit: Compile PDF"
      },
      {
        "command": "latexEditingToolkit.cleanArtifacts",
        "title": "LaTeX Editing Toolkit: Clean Build Artifacts"
      },
      {
        "command": "latexEditingToolkit.splitCurrentTarget",
        "title": "LaTeX Editing Toolkit: Split Current Target"
      },
      {
        "command": "latexEditingToolkit.renumberUnits",
        "title": "LaTeX Editing Toolkit: Renumber Units"
      },
      {
        "command": "latexEditingToolkit.unsplitUnit",
        "title": "LaTeX Editing Toolkit: Merge Unit Back To Root"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openSnippetsDir",
        "title": "Open Snippets Directory"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openWorkspaceSnippetsDir",
        "title": "Open Workspace Snippets Directory"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openWorkspaceSnippetFile",
        "title": "Open Workspace Snippet File"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openSnippetFile",
        "title": "Open Snippet File"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openSnippetManager",
        "title": "Open Snippet Manager"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.selectProfile",
        "title": "Select Snippet Profile"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.openActiveProfile",
        "title": "Open Active Snippet Profile"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.reloadSnippets",
        "title": "Reload Snippets"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.convertEnvironment",
        "title": "Convert LaTeX Environment"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.renameMatchingEnvironment",
        "title": "Rename Matching LaTeX Environment"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.wrapMathStructure",
        "title": "Wrap Math Structure"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.unwrapMathStructure",
        "title": "Unwrap Math Structure"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.smartEnter",
        "title": "Smart Math Enter"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.smartTab",
        "title": "Smart Alignment Tab"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.matrixTab",
        "title": "Insert Matrix Column Separator"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.leaveSnippet",
        "title": "Leave Snippet"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.nextPlaceholder",
        "title": "Next Snippet Placeholder"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.prevPlaceholder",
        "title": "Previous Snippet Placeholder"
      },
      {
        "category": "LaTeX Editing Toolkit: Snippets",
        "command": "hsnips.expand",
        "title": "Expand Snippet"
      }
    ],
    "configuration": {
      "title": "LaTeX Editing Toolkit: Snippets",
      "properties": {
        "hsnips.multiLineContext": { "type": "number", "default": 20, "description": "Number of lines matched when using multi-line regex mode." },
        "hsnips.windows": { "type": "string", "default": "%APPDATA%/Code/User/hsnips", "description": "Custom snippet path for Windows." },
        "hsnips.linux": { "type": "string", "default": "$HOME/.config/Code/User/hsnips", "description": "Custom snippet path for Linux." },
        "hsnips.mac": { "type": "string", "default": "$HOME/Library/Application Support/Code/User/hsnips", "description": "Custom snippet path for macOS." },
        "hsnips.context.extraMathEnvironments": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional LaTeX environments treated as math contexts." },
        "hsnips.context.extraRowBreakEnvironments": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional environments where Enter can append a row break." },
        "hsnips.context.extraAlignmentEnvironments": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional environments where Tab can insert an alignment separator." },
        "hsnips.context.extraTextLikeCommands": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional LaTeX commands whose argument is treated as text." },
        "hsnips.profiles.activeProfile": { "type": "string", "default": "", "description": "Active snippet profile loaded from hsnips/profiles/<name>. Empty means base snippets only." }
      }
    },
    "keybindings": [
      { "key": "enter", "command": "hsnips.smartEnter", "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && hsnips.canSmartEnter" },
      { "key": "tab", "command": "hsnips.smartTab", "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && hsnips.canSmartTab" },
      { "key": "shift+tab", "command": "hsnips.prevPlaceholder", "when": "editorTextFocus && hasPrevTabstop && inSnippetMode" },
      { "key": "escape", "command": "hsnips.leaveSnippet", "when": "editorTextFocus && inSnippetMode" },
      { "key": "shift+escape", "command": "hsnips.leaveSnippet", "when": "editorTextFocus && inSnippetMode" }
    ],
    "languages": [
      { "id": "hsnips", "extensions": [".hsnips"], "aliases": ["LatexSnips"] }
    ],
    "grammars": [
      { "language": "hsnips", "scopeName": "source.hsnips", "path": "./syntaxes/hsnips.tmLanguage.json", "embeddedLanguages": { "meta.embedded.js": "javascript" } }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexEditingToolkit",
          "title": "LaTeX Toolkit",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "views": {
      "latexEditingToolkit": [
        {
          "id": "latexEditingToolkit.actions",
          "name": "Toolkit"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "latexEditingToolkit.openToolkit"
        },
        {
          "command": "latexEditingToolkit.createProject"
        },
        {
          "command": "latexEditingToolkit.openLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.relocateLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.removeLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.refreshTree",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.undoLastChange"
        },
        {
          "command": "latexEditingToolkit.redoLastChange"
        },
        {
          "command": "latexEditingToolkit.createStarterInWorkspace"
        },
        {
          "command": "latexEditingToolkit.pickCompileTarget"
        },
        {
          "command": "latexEditingToolkit.pickCompileRecipe"
        },
        {
          "command": "latexEditingToolkit.toggleInternalFallback",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.openCurrentPdf"
        },
        {
          "command": "latexEditingToolkit.toggleThemeOption",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickClassConfig",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickStylePreset"
        },
        {
          "command": "latexEditingToolkit.pickBlockPreset",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickHeadingTocPreset",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickBodyFontSize"
        },
        {
          "command": "latexEditingToolkit.initializeWorkspace"
        },
        {
          "command": "latexEditingToolkit.upgradeWorkspaceThemeAssets"
        },
        {
          "command": "latexEditingToolkit.generateVscodeSettings"
        },
        {
          "command": "latexEditingToolkit.saveOverrides",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.resetOverrides"
        },
        {
          "command": "latexEditingToolkit.compilePdf"
        },
        {
          "command": "latexEditingToolkit.cleanArtifacts"
        },
        {
          "command": "latexEditingToolkit.splitCurrentTarget"
        },
        {
          "command": "latexEditingToolkit.renumberUnits"
        },
        {
          "command": "latexEditingToolkit.unsplitUnit"
        }
      ],
      "view/title": [
        {
          "command": "latexEditingToolkit.createProject",
          "when": "view == latexEditingToolkit.actions",
          "group": "navigation@1"
        },
        {
          "command": "latexEditingToolkit.refreshTree",
          "when": "view == latexEditingToolkit.actions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "latexEditingToolkit.removeLocalProject",
          "when": "view == latexEditingToolkit.actions && (viewItem == localProject || viewItem == localProjectMissing)",
          "group": "1_modification@2"
        },
        {
          "command": "latexEditingToolkit.relocateLocalProject",
          "when": "view == latexEditingToolkit.actions && viewItem == localProjectMissing",
          "group": "1_modification@1"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc --noEmit && node esbuild.mjs && npm run prepare-monaco",
    "prepare-monaco": "node scripts/prepare-monaco.js",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "vitest run",
    "test:extension": "npm run compile",
    "test": "npm run compile && npm run test:unit",
    "package": "npm run test && vsce package --no-dependencies"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.0",
    "monaco-editor": "^0.52.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
