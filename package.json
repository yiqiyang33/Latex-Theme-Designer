    "configuration": {
      "title": "LaTeX Editing Toolkit: Snippets",
      "properties": {
        "hsnips.multiLineContext": {
          "type": "number",
          "default": 20,
          "description": "Number of lines matched when using multi-line regex mode."
        },
        "hsnips.windows": {
          "type": "string",
          "default": "%APPDATA%/Code/User/hsnips",
          "description": "Custom snippet path for Windows."
        },
        "hsnips.linux": {
          "type": "string",
          "default": "$HOME/.config/Code/User/hsnips",
          "description": "Custom snippet path for Linux."
        },
        "hsnips.mac": {
          "type": "string",
          "default": "$HOME/Library/Application Support/Code/User/hsnips",
          "description": "Custom snippet path for macOS."
        },
        "hsnips.context.extraMathEnvironments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional LaTeX environments treated as math contexts."
        },
        "hsnips.context.extraRowBreakEnvironments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional environments where Enter can append a row break."
        },
        "hsnips.context.extraAlignmentEnvironments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional environments where Tab can insert an alignment separator."
        },
        "hsnips.context.extraTextLikeCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional LaTeX commands whose argument is treated as text."
        },
        "hsnips.profiles.activeProfile": {
          "type": "string",
          "default": "",
          "description": "Active snippet profile loaded from hsnips/profiles/<name>. Empty means base snippets only."
        },
        "overleafCodex.serverUrl": {
          "type": "string",
          "default": "https://www.overleaf.com/",
          "description": "Default Overleaf-compatible server URL."
        },
        "overleafCodex.localProjectsRoot": {
          "type": "string",
          "default": "~/Documents/OverleafCodex/projects",
          "description": "Default parent directory for local Overleaf mirrors."
        },
        "overleafCodex.compileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Compile the active Overleaf mirror after saving a supported source file."
        },
        "overleafCodex.syncBinaryFiles": {
          "type": "boolean",
          "default": false,
          "description": "Allow binary files to be uploaded during Overleaf synchronization."
        },
        "overleafCodex.autoPushLocalAhead": {
          "type": "boolean",
          "default": true,
          "description": "Automatically push local-ahead files after a sync check."
        },
        "overleafCodex.timeout": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Overleaf HTTP timeout in seconds."
        },
        "overleafCodex.connectTimeout": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Overleaf realtime connection timeout in seconds."
        },
        "overleafCodex.projectJoinTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Overleaf project join timeout in seconds."
        },
        "overleafCodex.httpTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Overleaf HTTP request timeout in seconds."
        },
        "overleafCodex.joinDocTimeout": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Overleaf document join timeout in seconds."
        },
        "overleafCodex.otAckTimeout": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Overleaf OT acknowledgement timeout in seconds."
        },
        "overleafCodex.syncDestructiveChanges": {
          "type": "boolean",
          "default": false,
          "description": "Allow destructive sync changes without an additional confirmation."
        },
        "latexEditingToolkit.overleaf.syncToolkitOverrides": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize LaTeX Editing Toolkit theme and configuration overrides with Overleaf."
        },
        "latexEditingToolkit.overleaf.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically maintain Overleaf mirror synchronization."
        },
        "latexEditingToolkit.overleaf.autoPushLocalAhead": {
          "type": "boolean",
          "default": true,
          "description": "Automatically push safe local-ahead source changes."
        },
        "latexEditingToolkit.overleaf.syncBinaryFiles": {
          "type": "boolean",
          "default": false,
          "description": "Allow binary files to be synchronized with Overleaf."
        },
        "latexEditingToolkit.overleaf.confirmDestructiveChanges": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before destructive Overleaf operations."
        },
        "latexEditingToolkit.overleaf.compileMode": {
          "type": "string",
          "enum": ["local", "overleaf"],
          "enumDescriptions": ["Compile using the local Toolkit compiler.", "Compile using the Overleaf remote compiler."],
          "default": "local",
          "description": "Preferred compile mode for the Toolkit Build section."
        }
      }
    },
    "keybindings": [
      {
        "key": "enter",
        "command": "hsnips.smartEnter",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && hsnips.canSmartEnter"
      },
      {
        "key": "tab",
        "command": "hsnips.smartTab",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && hsnips.canSmartTab"
      },
      {
        "key": "shift+tab",
        "command": "hsnips.prevPlaceholder",
        "when": "editorTextFocus && hasPrevTabstop && inSnippetMode"
      },
      {
        "key": "escape",
        "command": "hsnips.leaveSnippet",
        "when": "editorTextFocus && inSnippetMode"
      },
      {
        "key": "shift+escape",
        "command": "hsnips.leaveSnippet",
        "when": "editorTextFocus && inSnippetMode"
      }
    ],
    "languages": [
      {
        "id": "hsnips",
        "extensions": [
          ".hsnips"
        ],
        "aliases": [
          "LatexSnips"
        ]
      }
    ],
    "grammars": [
      {
        "language": "hsnips",
        "scopeName": "source.hsnips",
        "path": "./syntaxes/hsnips.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.js": "javascript"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexEditingToolkit",
          "title": "LaTeX Toolkit",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "views": {
      "latexEditingToolkit": [
        {
          "id": "latexEditingToolkit.actions",
          "name": "Toolkit"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "latexEditingToolkit.openToolkit"
        },
        {
          "command": "latexEditingToolkit.createProject"
        },
        {
          "command": "latexEditingToolkit.openLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.relocateLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.removeLocalProject",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.refreshTree",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.undoLastChange"
        },
        {
          "command": "latexEditingToolkit.redoLastChange"
        },
        {
          "command": "latexEditingToolkit.createStarterInWorkspace"
        },
        {
          "command": "latexEditingToolkit.pickCompileTarget"
        },
        {
          "command": "latexEditingToolkit.pickCompileRecipe"
        },
        {
          "command": "latexEditingToolkit.toggleInternalFallback",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.openCurrentPdf"
        },
        {
          "command": "latexEditingToolkit.toggleThemeOption",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickClassConfig",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickStylePreset"
        },
        {
          "command": "latexEditingToolkit.pickBlockPreset",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickHeadingTocPreset",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.pickBodyFontSize"
        },
        {
          "command": "latexEditingToolkit.initializeWorkspace"
        },
        {
          "command": "latexEditingToolkit.upgradeWorkspaceThemeAssets"
        },
        {
          "command": "latexEditingToolkit.generateVscodeSettings"
        },
        {
          "command": "latexEditingToolkit.saveOverrides",
          "when": "false"
        },
        {
          "command": "latexEditingToolkit.resetOverrides"
        },
        {
          "command": "latexEditingToolkit.compilePdf"
        },
        {
          "command": "latexEditingToolkit.cleanArtifacts"
        },
        {
          "command": "latexEditingToolkit.splitCurrentTarget"
        },
        {
          "command": "latexEditingToolkit.renumberUnits"
        },
        {
          "command": "latexEditingToolkit.unsplitUnit"
        }
      ],
      "view/title": [
        {
          "command": "latexEditingToolkit.createProject",
          "when": "view == latexEditingToolkit.actions",
          "group": "navigation@1"
        },
        {
          "command": "latexEditingToolkit.refreshTree",
          "when": "view == latexEditingToolkit.actions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "latexEditingToolkit.removeLocalProject",
          "when": "view == latexEditingToolkit.actions && (viewItem == localProject || viewItem == localProjectMissing)",
          "group": "1_modification@2"
        },
        {
          "command": "latexEditingToolkit.relocateLocalProject",
          "when": "view == latexEditingToolkit.actions && viewItem == localProjectMissing",
          "group": "1_modification@1"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc --noEmit && node esbuild.mjs && npm run prepare-monaco",
    "prepare-monaco": "node scripts/prepare-monaco.js",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "vitest run",
    "test:extension": "npm run compile",
    "test": "npm run compile && npm run test:unit",
    "package": "npm run test && vsce package --no-dependencies --out latex-editing-toolkit-2.0.0.vsix",
    "verify:vsix": "node scripts/verify-vsix.mjs latex-editing-toolkit-2.0.0.vsix"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "ignore": "^7.0.6",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.9",
    "node-fetch": "^2.7.0",
    "socket.io-client": "github:overleaf/socket.io-client#0.9.17-overleaf-5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.10",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^9.0.8",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.0",
    "monaco-editor": "^0.52.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
