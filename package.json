{
  "name": "latex-editing-toolkit",
  "displayName": "LaTeX Editing Toolkit",
  "description": "An integrated LaTeX workspace for themes, programmable hsnips, local and Overleaf builds, realtime sync, mirrors, and conflict resolution.",
