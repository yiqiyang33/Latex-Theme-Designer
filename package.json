  "publisher": "yiqiyang33",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yiqiyang33/Latex-Theme-Designer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "latex",
    "tex",
    "cursor",
    "notes",
    "template",
    "hsnips",
    "programmable snippets",
    "dynamic snippets",
    "overleaf",
    "realtime sync",
    "conflict resolution",
    "remote compile"
  ],
