\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theme}[2026/02/10 Unified visual theme for notes]

\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{tocloft}
\RequirePackage{titlesec}
\RequirePackage{tcolorbox}

\makeatletter
% Fallback defaults: if users do not define toggles in main.tex, use "true".
\@ifundefined{ifEnableHeadingTheme}{\newif\ifEnableHeadingTheme\EnableHeadingThemetrue}{}
\@ifundefined{ifEnableTOCTheme}{\newif\ifEnableTOCTheme\EnableTOCThemetrue}{}
\@ifundefined{ifEnablePageTheme}{\newif\ifEnablePageTheme\EnablePageThemetrue}{}
\@ifundefined{ifEnableEnhancedEnvStyle}{\newif\ifEnableEnhancedEnvStyle\EnableEnhancedEnvStyletrue}{}
\@ifundefined{ifEnableBlockShadow}{\newif\ifEnableBlockShadow\EnableBlockShadowtrue}{}
\makeatother

