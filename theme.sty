% Optional color override file generated by tools/theme_designer.py.
% Delete theme.colors.tex to return to the defaults in this file.
\InputIfFileExists{theme.colors.tex}{}{}

% -------------------- Document Theme --------------------
\ifEnableHeadingTheme
\titleformat{\chapter}[display]
    {\normalfont\huge\bfseries\color{theme-chapter}}
    {\filleft\Large\color{theme-chapter}Chapter \thechapter}
    {0.6ex}
    {\titlerule\vspace{0.8ex}\filright}
    [\vspace{0.6ex}\titlerule]
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

\titleformat{\section}
    {\normalfont\Large\bfseries\color{theme-section}}
    {\thesection}
    {0.6em}
    {}
\titlespacing*{\section}{0pt}{14pt}{7pt}

\titleformat{\subsection}
    {\normalfont\large\bfseries\color{theme-subsection}}
    {\thesubsection}
    {0.6em}
    {}
\titlespacing*{\subsection}{0pt}{10pt}{5pt}
\fi

\ifEnableTOCTheme
\renewcommand{\cfttoctitlefont}{\hfill\Huge\bfseries\color{theme-toc-title}}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftchapfont}{\bfseries\color{theme-toc-chapter}}
\renewcommand{\cftchappagefont}{\bfseries\color{theme-toc-chapter}}
\renewcommand{\cftsecfont}{\color{theme-toc-section}}
\renewcommand{\cftsecpagefont}{\color{theme-toc-section}}
\setlength{\cftbeforechapskip}{4pt}
\setlength{\cftbeforesecskip}{1pt}
\renewcommand{\cftdotsep}{1.6}
\fi

\ifEnablePageTheme
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\nouppercase{\leftmark}}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{theme-header-rule}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyhead[L]{\nouppercase{\leftmark}}
    \fancyhead[R]{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0pt}
    \renewcommand{\headrule}{\hbox to\headwidth{\color{theme-header-rule}\leaders\hrule height \headrulewidth\hfill}}
}
\fi

% -------------------- Block Theme --------------------
\ifEnableBlockShadow
\tcbset{
    theme/shadow/.style={
        borderline east={0.6pt}{0pt}{black!14!white},
        borderline south={0.6pt}{0pt}{black!14!white}
    }
}
\else
\tcbset{
    theme/shadow/.style={}
}
\fi

\ifEnableEnhancedEnvStyle
\tcbset{
    theorem/base/.style={
        enhanced,
        breakable,
        sharp corners,
        frame hidden,
        boxrule=0pt,
        left=5mm,
        right=4mm,
        top=2mm,
        bottom=2mm,
        before skip=10pt,
        after skip=10pt,
        titlerule=0mm,
        toptitle=1mm,
        bottomtitle=1mm,
        fonttitle=\bfseries\large,
        theme/shadow
    },
    theorem/variant/.style n args={4}{
        theorem/base,
        colback=#1,
        colbacktitle=#2,
        coltitle=#4,
        fonttitle=\bfseries\large\color{#4},
        borderline west={2.1pt}{0pt}{#3}
    },
    callout/base/.style={
        enhanced,
        breakable,
        sharp corners,
        boxrule=0pt,
        left=5mm,
        right=4mm,
        top=2mm,
        bottom=2mm,
        before skip=10pt,
        after skip=10pt,
        theme/shadow
    },
    callout/variant/.style n args={2}{
        callout/base,
        colback=#1,
        borderline west={1.4mm}{0pt}{#2}
    },
    callout/indented/.style={
        parbox=false,
        before upper={\parindent15pt}
    },
    note/base/.style={
        enhanced,
        breakable,
        sharp corners,
        boxrule=0pt,
        colback=note-bg,
        colframe=note-frame,
        left=5mm,
        right=5mm,
        top=3mm,
        bottom=3mm,
        before skip=10pt,
        after skip=10pt,
        coltitle=note-title-fg,
        fonttitle=\bfseries\color{note-title-fg},
        borderline west={2.2pt}{0pt}{note-accent},
        theme/shadow
    },
    note/title/.style={
        title={#1},
        colbacktitle=note-title-bg
    }
}
\else
\tcbset{
    theorem/base/.style={
        enhanced,
        breakable,
        frame hidden,
        titlerule=0mm,
        toptitle=1mm,
        bottomtitle=1mm,
        fonttitle=\bfseries\large
    },
    theorem/variant/.style n args={4}{
        theorem/base,
        colback=#1,
        colbacktitle=#2,
        coltitle=#4
    },
    callout/base/.style={
        blanker,
        breakable,
        left=5mm,
        before skip=10pt,
        after skip=10pt
    },
    callout/variant/.style n args={2}{
        callout/base,
        borderline west={1mm}{0pt}{#2}
    },
    callout/indented/.style={
        parbox=false,
        before upper={\parindent15pt}
    },
    note/base/.style={
        enhanced,
        breakable,
        sharp corners,
        boxrule=0pt,
        colback=note-bg,
        colframe=note-frame,
        left=5mm,
        right=5mm,
        top=3mm,
        bottom=3mm,
        before skip=10pt,
        after skip=10pt,
        coltitle=note-title-fg,
        fonttitle=\bfseries\color{note-title-fg}
    },
    note/title/.style={
        title={#1},
        colbacktitle=note-title-bg
    }
}
\fi
