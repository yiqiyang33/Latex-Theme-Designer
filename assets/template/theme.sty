% -------------------- Inline Text Theme --------------------
\makeatletter
\let\theme@originaltextbf\textbf
\renewcommand{\textbf}[1]{{\color{theme-bold}\theme@originaltextbf{#1}}}
\makeatother

% -------------------- Document Theme --------------------
\ifEnableHeadingTheme
\ifThemeUseChapterHeading
    \titleformat{\chapter}[display]
        {\normalfont\huge\bfseries\color{theme-chapter}}
        {\filleft\Large\color{theme-chapter}Chapter \thechapter}
        {0.6ex}
        {\titlerule\vspace{0.8ex}\filright}
        [\vspace{0.6ex}\titlerule]
    \titlespacing*{\chapter}{0pt}{0pt}{18pt}
\fi

\titleformat{\section}
    {\normalfont\Large\bfseries\color{theme-section}}
    {\thesection}
    {0.6em}
    {}
\titlespacing*{\section}{0pt}{14pt}{7pt}

\titleformat{\subsection}
    {\normalfont\large\bfseries\color{theme-subsection}}
    {\thesubsection}
    {0.6em}
    {}
\titlespacing*{\subsection}{0pt}{10pt}{5pt}
\fi

\ifEnableTOCTheme
\renewcommand{\cfttoctitlefont}{\hfill\Huge\bfseries\color{theme-toc-title}}
\renewcommand{\cftaftertoctitle}{\hfill}
\ifThemeHasChapter
    \renewcommand{\cftchapfont}{\bfseries\color{theme-toc-chapter}}
    \renewcommand{\cftchappagefont}{\bfseries\color{theme-toc-chapter}}
    \setlength{\cftbeforechapskip}{4pt}
\fi
\renewcommand{\cftsecfont}{\color{theme-toc-section}}
\renewcommand{\cftsecpagefont}{\color{theme-toc-section}}
\setlength{\cftbeforesecskip}{1pt}
\renewcommand{\cftdotsep}{1.6}
\fi

\ifEnablePageTheme
\pagestyle{fancy}
\fancyhf{}
\ifThemeUseSectionHeaderMark
    \renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}
    \fancyhead[L]{\nouppercase{\rightmark}}
\else
    \fancyhead[L]{\nouppercase{\leftmark}}
\fi
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{theme-header-rule}\leaders\hrule height \headrulewidth\hfill}}
\fancypagestyle{plain}{
    \fancyhf{}
    \ifThemeUseSectionHeaderMark
        \fancyhead[L]{\nouppercase{\rightmark}}
    \else
        \fancyhead[L]{\nouppercase{\leftmark}}
    \fi
    \fancyhead[R]{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0pt}
    \renewcommand{\headrule}{\hbox to\headwidth{\color{theme-header-rule}\leaders\hrule height \headrulewidth\hfill}}
}
\fi

% -------------------- Block Theme --------------------
\ifEnableBlockShadow
\tcbset{
    theme/shadow/.style={
        borderline east={0.45pt}{0pt}{black!8!white},
        borderline south={0.45pt}{0pt}{black!8!white}
    }
}
\else
\tcbset{
    theme/shadow/.style={}
}
\fi

\ifEnableEnhancedEnvStyle
\tcbset{
    theorem/base/.style={
        enhanced,
        breakable,
        arc=2pt,
        outer arc=2pt,
        frame hidden,
        boxrule=0pt,
        left=5mm,
        right=4mm,
        top=2mm,
        bottom=2mm,
        before skip=10pt,
        after skip=10pt,
        titlerule=0mm,
        toptitle=1mm,
        bottomtitle=1mm,
        fonttitle=\bfseries\large,
        theme/shadow
    },
    theorem/variant/.style n args={4}{
        theorem/base,
        colback=#1,
        colbacktitle=#2,
        coltitle=#4,
        fonttitle=\bfseries\large\color{#4},
        borderline west={1.6pt}{0pt}{#3}
    },
    callout/base/.style={
        enhanced,
        breakable,
        arc=2pt,
        outer arc=2pt,
        boxrule=0pt,
        left=5mm,
        right=4mm,
        top=2mm,
        bottom=2mm,
        before skip=10pt,
        after skip=10pt,
        theme/shadow
    },
    callout/variant/.style n args={2}{
        callout/base,
        colback=#1,
        borderline west={1mm}{0pt}{#2}
    },
    callout/indented/.style={
        parbox=false,
        before upper={\parindent15pt}
