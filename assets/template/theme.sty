\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theme}[2026/02/10 Unified visual theme for notes]

\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{tocloft}
\RequirePackage{titlesec}
\RequirePackage{tcolorbox}
\RequirePackage{marginnote}

\makeatletter
% Fallback defaults: if users do not define toggles in main.tex, use defaults.
\@ifundefined{ifEnableHeadingTheme}{\newif\ifEnableHeadingTheme\EnableHeadingThemetrue}{}
\@ifundefined{ifEnableTOCTheme}{\newif\ifEnableTOCTheme\EnableTOCThemetrue}{}
\@ifundefined{ifEnablePageTheme}{\newif\ifEnablePageTheme\EnablePageThemetrue}{}
\@ifundefined{ifEnableEnhancedEnvStyle}{\newif\ifEnableEnhancedEnvStyle\EnableEnhancedEnvStyletrue}{}
\@ifundefined{ifEnablePlainAmsthmTheorem}{\newif\ifEnablePlainAmsthmTheorem\EnablePlainAmsthmTheoremfalse}{}
\@ifundefined{ifEnableBlockShadow}{\newif\ifEnableBlockShadow\EnableBlockShadowtrue}{}

% Class-aware defaults (can be overridden by theme.overrides.tex).
\@ifundefined{ThemeClassMode}{\def\ThemeClassMode{auto}}{}
\@ifundefined{ThemeHeadingChapterMode}{\def\ThemeHeadingChapterMode{auto}}{}
\@ifundefined{ThemePageHeaderMode}{\def\ThemePageHeaderMode{auto}}{}
\@ifundefined{ThemeTheoremNumberingPolicy}{\def\ThemeTheoremNumberingPolicy{auto}}{}
\@ifundefined{ThemeBodyFontSizePt}{\def\ThemeBodyFontSizePt{}}{}

\newif\ifThemeHasChapter
\@ifundefined{chapter}{\ThemeHasChapterfalse}{\ThemeHasChaptertrue}

\newif\ifThemeBookClass
\ThemeBookClassfalse
\def\theme@mode@book{book}
\def\theme@mode@article{article}
\def\theme@mode@auto{auto}
\ifx\ThemeClassMode\theme@mode@book
    \ThemeBookClasstrue
\else
    \ifx\ThemeClassMode\theme@mode@article
        \ThemeBookClassfalse
    \else
        \ifThemeHasChapter
            \ThemeBookClasstrue
        \else
            \ThemeBookClassfalse
        \fi
    \fi
\fi

\newif\ifThemeUseChapterHeading
\ThemeUseChapterHeadingfalse
\def\theme@heading@on{on}
\def\theme@heading@off{off}
\ifx\ThemeHeadingChapterMode\theme@heading@off
    \ThemeUseChapterHeadingfalse
\else
    \ifx\ThemeHeadingChapterMode\theme@heading@on
        \ifThemeHasChapter\ThemeUseChapterHeadingtrue\fi
    \else
        \ifThemeBookClass
            \ifThemeHasChapter\ThemeUseChapterHeadingtrue\fi
        \fi
    \fi
\fi

\newif\ifThemeUseSectionHeaderMark
\ThemeUseSectionHeaderMarkfalse
\def\theme@header@chapter{chapter}
\def\theme@header@section{section}
\ifx\ThemePageHeaderMode\theme@header@section
    \ThemeUseSectionHeaderMarktrue
\else
    \ifx\ThemePageHeaderMode\theme@header@chapter
        \ifThemeHasChapter\ThemeUseSectionHeaderMarkfalse\else\ThemeUseSectionHeaderMarktrue\fi
    \else
        \ifThemeBookClass
            \ifThemeHasChapter\ThemeUseSectionHeaderMarkfalse\else\ThemeUseSectionHeaderMarktrue\fi
        \else
            \ThemeUseSectionHeaderMarktrue
        \fi
    \fi
\fi

\def\ThemeResolvedTheoremNumbering{section}
\def\theme@number@chapter{chapter}
\def\theme@number@section{section}
\def\theme@number@none{none}
\ifx\ThemeTheoremNumberingPolicy\theme@number@none
    \def\ThemeResolvedTheoremNumbering{none}
\else
    \ifx\ThemeTheoremNumberingPolicy\theme@number@section
        \def\ThemeResolvedTheoremNumbering{section}
    \else
        \ifx\ThemeTheoremNumberingPolicy\theme@number@chapter
            \ifThemeHasChapter
                \def\ThemeResolvedTheoremNumbering{chapter}
            \else
                \def\ThemeResolvedTheoremNumbering{section}
            \fi
        \else
            \ifThemeBookClass
                \ifThemeHasChapter
                    \def\ThemeResolvedTheoremNumbering{chapter}
                \else
                    \def\ThemeResolvedTheoremNumbering{section}
                \fi
            \else
                \def\ThemeResolvedTheoremNumbering{section}
            \fi
        \fi
    \fi
\fi

\def\theme@empty{}
\def\theme@bodyfontsize{}
\def\theme@bodybaseline{}
\ifx\ThemeBodyFontSizePt\theme@empty
\else
    \begingroup
        \dimen@=\ThemeBodyFontSizePt pt\relax
        \ifdim\dimen@>0pt
            \dimen@ii=1.2\dimen@
            \xdef\theme@bodyfontsize{\strip@pt\dimen@}
            \xdef\theme@bodybaseline{\strip@pt\dimen@ii}
        \fi
    \endgroup
\fi
\AtBeginDocument{
    \ifx\theme@bodyfontsize\theme@empty
    \else
        \fontsize{\theme@bodyfontsize pt}{\theme@bodybaseline pt}\selectfont
    \fi
}
\makeatother

